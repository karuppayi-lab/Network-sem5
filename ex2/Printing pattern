#include <stdio.h>

int main() {
    int n;
    // Read the input value
    if (scanf("%d", &n) != 1) return 0;
    
    // The size of the grid is always (2 * n - 1)
    int size = 2 * n - 1;
    
    // Loop through each row
    for (int i = 0; i < size; i++) {
        // Loop through each column
        for (int j = 0; j < size; j++) {
            
            // Calculate the minimum distance of the current cell (i, j) 
            // from the four edges of the square grid.
            int min_dist = i < j ? i : j;
            min_dist = min_dist < (size - 1 - i) ? min_dist : (size - 1 - i);
            min_dist = min_dist < (size - 1 - j) ? min_dist : (size - 1 - j);
            
            // The value to print decreases by 1 for every step closer to the center
            printf("%d ", n - min_dist);
        }
        // Move to the next line after finishing a row
        printf("\n");
    }
    return 0;
}
