#include <stdio.h>
#include <ctype.h>

void solve() {
    int t;
    if (scanf("%d", &t) != 1) return;

    while (t--) {
        char s[100005]; 
        scanf("%s", s);

        int digit_sum = 0;
        for (int i = 0; s[i] != '\0'; i++) {
            if (isdigit((unsigned char)s[i])) {
                digit_sum += (s[i] - '0');
            }
        }
        printf("%d\n", digit_sum);
    }
}

int main() {
    solve();
    return 0;
}
