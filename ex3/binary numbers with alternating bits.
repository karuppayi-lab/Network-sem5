#include <stdio.h>
#include <stdbool.h>

bool hasAlternatingBits(int n) {
    // Step 1 & 2: XOR n with itself shifted right by 1
    // If n has alternating bits, x will have all bits set to 1.
    unsigned int x = n ^ (n >> 1);
    
    // Step 3: Check if x + 1 clears all bits of x
    return (x & (x + 1)) == 0;
}

