#include <stdio.h>
#include <string.h>
#include <stdlib.h>
// Function to reverse a string in-place
void reverseString(char *str) {  
    int i = 0;
    int j = strlen(str) - 1;
    while (i < j) {
        char temp = str[i];
        str[i] = str[j];
        str[j] = temp;
        i++;
        j--;
    }
}
char* addBinary(char* a, char* b) {
    int i = strlen(a) - 1;
    int j = strlen(b) - 1;
    int carry = 0;   
    // Allocate memory for the result string
    // Max length is max(len(a), len(b)) + 1 for potential carry + 1 for null-terminator
    int maxLen = (i > j ? i : j) + 3; 
    char* result = (char*)malloc(maxLen * sizeof(char));
    int k = 0;
    // Loop from right to left until both strings are processed and no carry remains
    while (i >= 0 || j >= 0 || carry > 0) {
        int sum = carry;
        if (i >= 0) {
            sum += a[i] - '0'; // Convert character bit to integer (0 or 1)
            i--;
        }
        if (j >= 0) {
            sum += b[j] - '0';
            j--;
        }
        // Calculate new carry and the current bit value
        carry = sum / 2;
        result[k++] = (sum % 2) + '0'; // Convert back to character bit
    }    
    result[k] = '\0'; // Null-terminate the string
    reverseString(result); // Reverse since we added from right to left
    return result;
}
