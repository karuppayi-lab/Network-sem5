#include <stdio.h>
#include <stdlib.h>

// Helper function to remove duplicates from an array in-place.
// Returns the new size of the array.
int removeDuplicates(int *arr, int size) {
    if (size <= 1) return size;
    
    int newSize = 0;
    for (int i = 0; i < size; i++) {
        int isDuplicate = 0;
        for (int j = 0; j < newSize; j++) {
            if (arr[i] == arr[j]) {
                isDuplicate = 1;
                break;
            }
        }
        if (!isDuplicate) {
            arr[newSize++] = arr[i];
        }
    }
    return newSize;
}

// Comparison function for qsort to sort integers in ascending order
int compareInts(const void *a, const void *b) {
    return (*(int*)a - *(int*)b);
}

int subarrayBitwiseORs(int* arr, int arrSize) {
    // Total unique results can be at most 30 * arrSize
    int maxTotalPossible = 30 * arrSize;
    int *totalOrs = (int *)malloc(maxTotalPossible * sizeof(int));
    int totalCount = 0;

    // Arrays to hold OR results for the previous step and current step
    // Bounded by 32 because an integer has only 32 bits
    int prevOrs[32];
    int prevSize = 0;

    for (int i = 0; i < arrSize; i++) {
        int x = arr[i];
        int currOrs[32];
        int currSize = 0;

        // 1. Every element forms a subarray of length 1 by itself
        currOrs[currSize++] = x;

        // 2. Perform bitwise OR with all results from the previous index
        for (int j = 0; j < prevSize; j++) {
            currOrs[currSize++] = prevOrs[j] | x;
        }

        // 3. Remove duplicates within the current step to keep the array size <= 30
        currSize = removeDuplicates(currOrs, currSize);

        // 4. Save current results into our global tracking array
        for (int j = 0; j < currSize; j++) {
            totalOrs[totalCount++] = currOrs[j];
        }

        // 5. Pass current results to the next iteration
        prevSize = currSize;
        for (int j = 0; j < currSize; j++) {
            prevOrs[j] = currOrs[j];
        }
    }

    // 6. Sort and remove duplicates from the entire collection to find unique values
    qsort(totalOrs, totalCount, sizeof(int), compareInts);
    
    // In-place unique filtering on the sorted total array
    int uniqueCount = 0;
    if (totalCount > 0) {
        uniqueCount = 1;
        for (int i = 1; i < totalCount; i++) {
            if (totalOrs[i] != totalOrs[i - 1]) {
                totalOrs[uniqueCount++] = totalOrs[i];
            }
        }
    }

    free(totalOrs);
    return uniqueCount;
}
